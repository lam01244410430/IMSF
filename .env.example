# IMSF-v2 environment — placeholder keys only, no real values.
# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://imsf_v2:imsf_v2@127.0.0.1:55434/imsf_v2
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=change-me-to-a-random-secret
# GPU_HOST is the EPHEMERAL IP of the GPU VM (Ollama/Qwen 14B).
# Update it whenever the GPU VM restarts.
GPU_HOST=<gpu-vm-ip>
# Ollama is reached through the SSH tunnel (ollama-tunnel.service);
# never point this at the GPU IP directly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OCR provider: baidu | qwen-vl | mock (default baidu).
OCR_PROVIDER=baidu
# Baidu AI Cloud OCR (通用票据识别) — real-name-verified account required.
# No real values exist yet; leave empty until Lam provides them.
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# WeChat Mini Program login (D2 deferred by Lam — leave empty for now).
WECHAT_APPID=
WECHAT_SECRET=
# Eval/demo-only service token (server-side only, never in a client).
# Generate with: openssl rand -hex 32
IMSF_V2_SERVICE_TOKEN=
# Where receipt images are stored on disk.
RECEIPT_STORAGE_DIR=/var/lib/imsf-v2/receipts

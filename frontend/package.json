{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "description": "IMSF-v2 frontend",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "theme:build": "node scripts/build-tokens.mjs",
    "theme:check": "node scripts/build-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "check:twins": "node scripts/check-platform-twins.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@nutui/nutui-react-taro": "3.0.20",
    "@tanstack/react-query": "5.108.2",
    "@tarojs/components": "4.3.3",
    "@tarojs/helper": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-platform-h5": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.3.3",
    "@tarojs/plugin-generator": "4.3.3",
    "@tarojs/taro-loader": "4.3.3",
    "@tarojs/webpack5-runner": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/minimatch": "^5",
    "@types/node": "22.20.5",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-plugin-import": "1.13.8",
    "babel-preset-taro": "4.3.3",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.3.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "husky": "^9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "webpack": "5.91.0"
  }
}
